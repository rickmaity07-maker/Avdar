rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // SAFE ADMIN CHECK: Emails go first to prevent get() crashes!
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'rick.maity07@gmail.com' ||
        request.auth.token.email == 'admin.avdar@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isOwnerOrAdmin(userId);
    }

    match /clientNotes/{userId} {
      allow read, write: if isAdmin();
    }

    // 🚨 FIX 1: Fully open read access to stop the crash
    match /appointments/{apptId} {
      allow read: if true; 
      
      allow create: if isAdmin() || isOwner(request.resource.data.userId);
      allow update: if isAdmin() || (
        isOwner(resource.data.userId) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referenceImage']) ||
          (
            resource.data.status == 'proposed' &&
            (
              (request.resource.data.status == 'confirmed' &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'date', 'time', 'proposedDate', 'proposedTime'])) ||
              (request.resource.data.status == 'cancelled' &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
            )
          )
        )
      );
      allow delete: if isAdmin();
    }

    match /services/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /stylists/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // 🚨 FIX 2: Fully open read access to stop the crash
    match /alerts/{alertId} {
      allow read: if true;
      allow write: if isAdmin() || isOwner(request.resource.data.userId);
    }
    
    match /waitlist/{waitlistId} {
      allow read: if true;
      allow create: if isAdmin() || isOwner(request.resource.data.userId);
      allow update, delete: if isAdmin();
    }
    match /translations/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}